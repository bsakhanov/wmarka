	<author>Webmarka</author>
	<creationDate>2026-10</creationDate>
	<copyright>(C) 2026 Webmarka</copyright>
	<license>GNU General Public License version 2 or later</license>
	<authorUrl>https://webmarka.kz</authorUrl>
	<version>4.0.10</version>
	<description>PLG_SAMPLEDATA_WMARKA_XML_DESCRIPTION</description>
	<namespace path="src">Webmarka\Plugin\Sampledata\Wmarka</namespace>
	<files>
		<folder plugin="wmarka">services</folder>
		<folder>src</folder>
		<folder>data</folder>
		<folder>language</folder>
	</files>
	<media destination="plg_sampledata_wmarka" folder="media">
