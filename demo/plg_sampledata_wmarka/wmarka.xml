	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="registry" type="textarea" label="PLG_SAMPLEDATA_WMARKA_REGISTRY_LABEL" description="PLG_SAMPLEDATA_WMARKA_REGISTRY_DESC" rows="6" readonly="true" filter="raw" />
			</fieldset>
		</fields>
	</config>
