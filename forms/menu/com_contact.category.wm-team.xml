<?xml version="1.0" encoding="utf-8"?>
<!-- Поля WMARKA для пунктов меню com_contact → category → wm-team. Добавляет их к форме ядра плагин «Система — wmarka»; поля самого ядра плагин берёт из макета «default» компонента -->
<form base="default">
    <fields name="params">

        <fieldset name="wmarka" label="TPL_WMARKA_MENU_OPTIONS">
        	<field name="wm_view" type="list" label="TPL_WMARKA_M_VIEW" default="grid"><option value="grid">TPL_WMARKA_M_VIEW_GRID</option><option value="list">TPL_WMARKA_M_VIEW_LIST</option></field>
        	<field name="wm_switch" type="radio" label="TPL_WMARKA_M_SWITCH" layout="joomla.form.field.radio.switcher" default="1" filter="integer"><option value="0">JNO</option><option value="1">JYES</option></field>
        	<field name="wm_columns" type="list" label="TPL_WMARKA_M_COLUMNS" default="4"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
        </fieldset>
    </fields>
</form>
