<?xml version="1.0" encoding="utf-8"?>
<!-- Поля WMARKA для пунктов меню com_tags → tag → default. Добавляет их к форме ядра плагин «Система — wmarka» -->
<form>
    <fields name="params">

        <fieldset name="wmarka" label="TPL_WMARKA_MENU_OPTIONS">
        	<field name="wm_media" type="list" label="TPL_WMARKA_M_MEDIA" description="TPL_WMARKA_M_MEDIA_DESC" default="top"><option value="top">TPL_WMARKA_M_MEDIA_TOP</option><option value="bottom">TPL_WMARKA_M_MEDIA_BOTTOM</option><option value="left">TPL_WMARKA_M_MEDIA_LEFT</option><option value="right">TPL_WMARKA_M_MEDIA_RIGHT</option><option value="alternate">TPL_WMARKA_M_MEDIA_ALT</option></field>
        	<field name="wm_intro_limit" type="number" label="TPL_WMARKA_M_INTRO" description="TPL_WMARKA_M_INTRO_DESC" default="" min="0" />
        	<field name="wm_view" type="list" label="TPL_WMARKA_M_VIEW" default="grid"><option value="grid">TPL_WMARKA_M_VIEW_GRID</option><option value="list">TPL_WMARKA_M_VIEW_LIST</option></field>
        	<field name="wm_switch" type="radio" label="TPL_WMARKA_M_SWITCH" layout="joomla.form.field.radio.switcher" default="1" filter="integer"><option value="0">JNO</option><option value="1">JYES</option></field>
        	<field name="wm_columns" type="list" label="TPL_WMARKA_M_COLUMNS" default="3"><option value="1">1</option><option value="2">2</option><option value="3">3</option><option value="4">4</option><option value="5">5</option><option value="6">6</option></field>
        	<field name="wm_masonry" type="radio" label="TPL_WMARKA_M_MASONRY" layout="joomla.form.field.radio.switcher" default="1" filter="integer"><option value="0">JNO</option><option value="1">JYES</option></field>
        	<field name="wm_gutter" type="list" label="TPL_WMARKA_M_GUTTER" default="medium"><option value="collapse">TPL_WMARKA_M_G_COLLAPSE</option><option value="small">TPL_WMARKA_M_G_SMALL</option><option value="medium">TPL_WMARKA_M_G_MEDIUM</option><option value="large">TPL_WMARKA_M_G_LARGE</option></field>
        </fieldset>
    </fields>
</form>
