<?xml version="1.0" encoding="utf-8"?>
<!-- Поля WMARKA для пунктов меню com_tags → tags → wm-tree. Добавляет их к форме ядра плагин «Система — wmarka»; поля самого ядра плагин берёт из макета «default» компонента -->
<form base="default">
    <fields name="params">

        <fieldset name="wmarka" label="TPL_WMARKA_MENU_OPTIONS">
        	<field name="wm_exclude_tags" type="text" label="TPL_WMARKA_M_EXCLUDE" description="TPL_WMARKA_M_EXCLUDE_DESC" default="" />
        	<field name="wm_show_categories" type="radio" label="TPL_WMARKA_M_SHOWCATS" layout="joomla.form.field.radio.switcher" default="1" filter="integer"><option value="0">JNO</option><option value="1">JYES</option></field>
        </fieldset>
    </fields>
</form>
